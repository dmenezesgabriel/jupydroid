# Shared editor/formatting conventions for ktlint and editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

# **2, and it is the house style rather than a preference restated.** This file claimed 4 for
# `.kt` from Step 1 and no `.kt` file has ever used it: every source in `app/src` is 2-space, and
# `ktlintCheck` never said so because it was never checking them (`docs/DECISIONS.md`). Turning the
# gate on reported **9,864 indentation offences out of 11,939** - which was the config being wrong,
# not 200 files being wrong.
[*.kt]
indent_size = 2
indent_style = space
max_line_length = 120

# Gradle scripts are AGP's own 4-space idiom and were written that way; they are the only Kotlin
# here ktlint *was* checking, so they are already formatted to it.
[*.kts]
indent_size = 4
indent_style = space
max_line_length = 120

[{*.kt,*.kts}]
# **The style the code was written in, rather than the one the plugin defaults to.** ktlint 1.x
# defaults to `ktlint_official`, whose `function-signature` rule breaks any signature of two or
# more parameters across lines regardless of width - which is not what this codebase does and not
# what `max_line_length = 120` is for: it turned a 110-character `CollapsedCell(...)` into six
# lines and added 108 lines to one test file, pushing five over the 500-line gate. `intellij_idea`
# is what Android Studio wrote these files with.
ktlint_code_style = intellij_idea

# `@Composable` functions are PascalCase by Compose's own convention - `Text`, `CellHeader` - which
# is the same exemption `config/detekt/detekt.yml` already makes for them under `LongMethod`.
ktlint_function_naming_ignore_when_annotated_with = Composable

# **A file-header KDoc is this project's convention, and 19 files carry one.**
# `standard:no-consecutive-comments` refuses *"a KDoc may not be preceded by a KDoc"*, which is
# exactly what a header is - see `ui/editor/CellSelection.kt`, where one names what the file is for
# before the first function's own KDoc says what that function does. Those headers carry intent and
# provenance, which `CLAUDE.md` says not to strip on a refactor, and rewriting all 19 into block
# comments to satisfy a rule the project has decided against is the tail wagging the dog.
ktlint_standard_no-consecutive-comments = disabled
