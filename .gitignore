# Generated by tools/rootfs/stage-app-artifacts.sh from the digest-pinned image:
# a ~54 MB rootfs archive and the two ELFs that get execve'd. Reproducible, and
# far too big for git.
/app/src/main/assets/spaces/
/app/src/main/jniLibs/

# ANTLR output: generated from the vendored grammar in tools/grammars/python, reproducible
# and not something to review as a diff.
/app/build/generated/

# Python bytecode from the maestro gate and its tests, which run out of scripts/.
__pycache__/

# Full-device dumps record the whole device, not this app: the home Wi-Fi BSSID/SSID, push
# tokens, every other app's activity. They stay on disk as evidence and never reach the remote
# (history was rewritten once to remove them, docs/DECISIONS.md).
evidence/**/*logcat*.txt
evidence/**/activities.txt
evidence/**/dumpsys*.txt

# Personal session prompt, and the local list of literals the device-secrets gate refuses.
/prompt.md
/.sensitive-strings.local
