*.iml
.gradle
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/build
/captures
# playwright-cli session snapshots and logs stay local (ADR-0132); the curated frames are committed under docs-site/pages/images/.
/.playwright-cli/
.externalNativeBuild
.cxx
local.properties
/.idea/
/reference/
.kotlin/
*.hprof

# Generated by tools/rootfs/stage-app-artifacts.sh from the digest-pinned image:
# a ~57 MB rootfs archive and the ELFs that get execve'd. Reproducible, and
# far too big for git.
/app/src/main/assets/spaces/
/app/src/main/jniLibs/

# Generated by tools/proot/build.sh + scripts/stage_proot_patched.py: the patched
# proot pair an instrumented probe execs, and the pinned upstream tarball it is
# built from. Both reproducible, neither committed.
/app/src/androidTest/jniLibs/
/tools/proot/proot-5.4.0.tar.gz

# ANTLR output: generated from the vendored grammar in tools/grammars/python, reproducible
# and not something to review as a diff.
/app/build/generated/

# Python bytecode from the maestro gate and its tests, which run out of scripts/.
__pycache__/

# A device run's screenshots, dumps and logs stay on the disk that ran it and never reach the
# remote: what must be reproducible ships as a tested script instead (ADR-0132). Full-device dumps
# in it record the whole device, not this app - the home Wi-Fi BSSID/SSID, push tokens, every
# other app's activity (ADR-0015).
/evidence/

# The local list of literals the device-secrets gate refuses. `prompt-execution.md` is tracked: a
# clean session needs it, so it cannot be personal (ADR-0001).
/.sensitive-strings.local
.venv/
# The commit-message tooling's dependencies (package-lock.json is the record).
node_modules/

# autopilot's journal, answer files and raw ACP transcripts. Outside scripts/ because the
# doc-citations gate reads every file under it.
/.autopilot-run/

# Claude Code's own lock for a scheduled task. It is rewritten by every session that runs in this
# tree, and a tracked copy left the tree dirty, which the autopilot reads as an unfinished commit.
/.claude/scheduled_tasks.lock
