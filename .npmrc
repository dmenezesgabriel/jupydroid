# npm's defaults run a dependency's install scripts, accept git dependencies and take a release the minute
# it is published. This tree only checks commit messages, so none of that is needed and all of it is the
# usual way an npm package reaches a developer's machine. Tested by npmrc.test.mjs.

# `npm test` and `npm run` still run their own script; a dependency's preinstall/postinstall never does.
ignore-scripts=true

# A git reference is not covered by the registry's integrity hash or signature.
allow-git=none

# Days. Matches the Dependabot cooldown in .github/dependabot.yml: a fresh release is the window in
# which a compromised publish is usually caught and pulled. It governs what `npm install` resolves;
# `npm ci` installs exactly what package-lock.json records.
min-release-age=7

# A Node older than package.json's `engines` fails the install instead of printing a warning.
engine-strict=true

# `npm install <pkg>` records 1.2.3, not ^1.2.3, so the lockfile is the only thing that moves a version.
save-exact=true
