<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Required even though jupyter_server only ever binds 127.0.0.1: Android gates
      AF_INET sockets behind the "inet" supplementary GID, which this permission
      grants. Without it socket() fails with EPERM, in the app and in any process it
      spawns. Nothing here talks to the network - see network_security_config, which
      permits cleartext to loopback only.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.JupyterDroid">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- .ipynb has no standard MIME type and file managers hand out
                     content URIs whose path does not encode the extension
                     (e.g. MediaStore /external/file/<id>), so match any content
                     URI and validate the extension via the display name. -->
                <data
                    android:scheme="content"
                    android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>

</manifest>
