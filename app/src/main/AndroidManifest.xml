<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Required even though jupyter_server only ever binds 127.0.0.1: Android gates
      AF_INET sockets behind the "inet" supplementary GID, which this permission
      grants. Without it socket() fails with EPERM, in the app and in any process it
      spawns. Nothing here talks to the network - see network_security_config, which
      permits cleartext to loopback only.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Read-only, granted at install with no runtime prompt: lets SpaceRuntime read the device's
      current DNS servers via ConnectivityManager for tools/rootfs/getaddrinfo_shim.c - musl's
      own resolver reads /etc/resolv.conf and nothing else, and redirecting that path was measured
      and ruled out, so the shim interposes the call instead (ADR-0005).
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      android:name is what makes the composition root one *per process*: MainActivity is
      relaunched on every rotation, and a container per activity instance was measured to be a
      jupyter_server per activity instance. `JupydroidApplication` builds the one container;
      `docs/architecture/building-blocks.md` §5 states the rule.

      hasFragileUserData makes the system's uninstall offer to keep the app's data. An uninstall
      removes filesDir, and every Space - its home with the user's notebooks, files and chats, and
      whatever was installed into its rootfs - lives there. The platform default is false
      (developer.android.com/guide/topics/manifest/application-element#fragileuserdata).

      backupAgent with fullBackupOnly hands Auto Backup what the user made and nothing a reinstall
      rebuilds: all of filesDir, rootfs included, is past the 25 MB quota, and over it nothing is
      backed up at all. app/src/main/java/com/jupydroid/app/data/backup/SpaceHomeBackupAgent.kt
      says why no dataExtractionRules file goes with it.
    -->
    <application
        android:name=".JupydroidApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:backupAgent=".data.backup.SpaceHomeBackupAgent"
        android:fullBackupOnly="true"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JupyterDroid">
        <!--
          windowSoftInputMode belongs on the activity, not on <application>: the platform only
          reads it here, and set one level up it is silently ignored. It was, and the activity
          therefore ran at the framework default, which resolved to `adjust=pan` - visible in
          `dumpsys window` as `sim={adjust=pan}`. Panning translates the whole window to keep
          the focused field on screen, which dragged the top app bar up under the status bar
          whenever the keyboard opened. Resize instead, so the keyboard arrives as an inset the
          layout can respond to rather than as a shove.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- .ipynb has no standard MIME type and file managers hand out
                     content URIs whose path does not encode the extension
                     (e.g. MediaStore /external/file/<id>), so match any content
                     URI and validate the extension via the display name. -->
                <data
                    android:scheme="content"
                    android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          An exported file leaves the app through a `content://` URI, never a `file://` one
          (ADR-0051) - passing a file URI out has thrown `FileUriExposedException` since Android 7, and
          the workspace is private storage no other app could read anyway. The provider grants a
          one-shot read to whichever app the user picks from the chooser.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/exported_documents" />
        </provider>
    </application>

</manifest>
