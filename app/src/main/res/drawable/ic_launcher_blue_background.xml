<?xml version="1.0" encoding="utf-8"?>
<!--
  The blue icon's field: the supplied artwork's surround is a radial gradient, brightest at the
  top-centre and falling to dark navy at the edges and bottom - measured luminance roughly 87 to
  49 across the canvas, centred at (0.5, 0.05) of the layer. Three stops at the measured colours,
  radius 95% of the layer so the far corners settle on the end colour; a flat colour would lose
  the glow the artwork is built around. Adaptive-icon backgrounds are masked by the launcher, so
  this drawable fills the whole 108dp layer.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:centerX="0.5"
        android:centerY="0.05"
        android:gradientRadius="95%p"
        android:startColor="#1D6CD2"
        android:centerColor="#0E4EB8"
        android:endColor="#05338D" />
</shape>
