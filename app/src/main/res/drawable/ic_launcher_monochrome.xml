        android:pathData="M22,54A32,13 0 0,1 86,54A32,13 0 0,1 22,54"
        android:strokeColor="#FF000000"
        android:strokeWidth="5"
        android:fillColor="#00000000" />
    <path
        android:pathData="M34,54a20,20 0 1,0 40,0a20,20 0 1,0 -40,0"
        android:fillColor="#FF000000" />
</vector>
