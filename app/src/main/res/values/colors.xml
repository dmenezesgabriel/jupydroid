<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      LightEditorPalette.editorBackground (`notebook.editorBackground`, resolved). Duplicated from Kotlin on purpose and
      not by oversight: the window is drawn before Compose exists, so this value cannot be read
      from the palette. Keep the two in step - a mismatch shows as a flash of the wrong colour on
      every cold launch.
    -->
    <color name="window_background">#FFFFFFFF</color>

    <!--
      Adaptive-icon backdrop for each launcher variant, sampled from the artwork's own surround:
      the blue variant's corners sit on dark navy, the black variant's on near-black. The
      foreground bitmaps carry the surround opaquely, so these only show in the thin ring the
      launcher mask leaves outside the 72dp artwork square.
    -->
    <color name="ic_launcher_blue_background">#001439</color>
    <color name="ic_launcher_black_background">#010101</color>

</resources>
