<?xml version="1.0" encoding="utf-8"?>
<!--
  What IntentDocumentSharer may hand out: the workspace, and nothing else under files/.

  Scoped to `spaces/base/home/jupydroid` rather than to `files/` because everything else in this
  app's private storage is either the rootfs or app state - `recent-documents.json`,
  `editor-settings.json`, the server's runtime directory and its token. A provider rooted at
  `files/` would be able to hand any of those to any app the user picked.

  `files-path` is `Context.getFilesDir()`, which is what `notebookWorkspaceIn` is built from.
-->
<paths>
    <files-path name="workspace" path="spaces/base/home/jupydroid/" />
</paths>
