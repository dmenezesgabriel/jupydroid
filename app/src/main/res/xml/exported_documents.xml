<?xml version="1.0" encoding="utf-8"?>
<!--
  What IntentDocumentSharer may hand out: a Space's workspace, and nothing else under files/.

  Scoped to `spaces/` rather than to `files/` because everything else in this app's private storage
  is app state - `recent-documents.json`, `editor-settings.json`. Not narrower, because a Space's id
  is chosen at runtime and a `<files-path>` cannot hold a wildcard; `spaces/` also holds each Space's
  rootfs and its server's runtime directory and token, so `IntentDocumentSharer.uriFor` refuses any
  path that leaves the Space's own `home/jupydroid` before the provider sees it.

  `files-path` is `Context.getFilesDir()`, which is what `spacesDir` is built from.
-->
<paths>
    <files-path name="spaces" path="spaces/" />
</paths>
