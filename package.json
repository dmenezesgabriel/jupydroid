{
  "name": "jupydroid-commit-tooling",
  "private": true,
  "description": "Checks commit messages. The app is built by Gradle and its host tooling by uv; nothing here ships.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "commit": "cz",
    "test": "node --experimental-transform-types --no-warnings --test \"*.test.mjs\" \"scripts/claude-autopilot/*.test.ts\"",
    "typecheck": "tsc -p scripts/claude-autopilot/tsconfig.json"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/cz-commitlint": "21.2.4",
    "@types/node": "26.6.6",
    "commitizen": "4.3.2",
    "inquirer": "12.11.1",
    "typescript": "6.0.3"
  }
}
