#!/usr/bin/env bash
# Wraps ./gradlew with the Android Studio JBR so pre-commit's gradle hooks are
# self-contained (JAVA_HOME is not guaranteed in the hook environment).
# Used by .pre-commit-config.yaml for the ktlint/detekt/lint/test hooks.
set -euo pipefail

# shellcheck source=scripts/java-home.sh
. "$(dirname "${BASH_SOURCE[0]}")/java-home.sh"

exec ./gradlew "$@"
