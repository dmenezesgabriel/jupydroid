 /**
+ * Whether a seccomp-trapped syscall is one only a loader's startup can
+ * issue: the optional calls glibc's ld.so makes before any preload
+ * constructor can arm a SIGSYS handler (set_robust_list, rseq).  The
+ * set is the whole refused set of one complete startup trace, derived
+ * once - package code cannot run inside that window, so nothing a
+ * package does can ever need a case here.  Every later refusal is the
+ * guest's own SIGSYS handler's to answer with ENOSYS, or ENOSYS-only
+ * under PROOT_SIGSYS_ENOSYS.
+ */
+static bool seccomp_trap_is_enosys_safe(Sysnum sysnum)
+{
+	switch (sysnum) {
+	case PR_set_robust_list:
+	case PR_rseq:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/**
+ * The syscall a SIGSYS stop was raised for: PR_void when the stop is not a
+ * seccomp trap or its number cannot be read.  @is_seccomp tells the two
+ * apart - a genuine SIGSYS (si_code != SYS_SECCOMP) must still be delivered
+ * even under PROOT_SIGSYS_ENOSYS.  @arch_nr is the raw number the kernel
+ * reports (-1 likewise); si_syscall is the architecture's own number - on
+ * arm64 the one in x8 - which is also what get_sysnum translates.
+ * @regs_ready is true only when the tracee's register bank was fetched,
+ * which the ENOSYS answer needs before it can be written back.
+ */
+static Sysnum seccomp_trap_sysnum(Tracee *tracee, int *arch_nr, bool *is_seccomp, bool *regs_ready)
+{
+	siginfo_t siginfo;
+
+	*arch_nr = -1;
+	*is_seccomp = false;
+	*regs_ready = false;
+	if (ptrace(PTRACE_GETSIGINFO, tracee->pid, NULL, &siginfo) < 0)
+		return PR_void;
+	if (siginfo.si_code != SYS_SECCOMP)
+		return PR_void;
+	*is_seccomp = true;
+	*arch_nr = siginfo.si_syscall;
+	if (fetch_regs(tracee) < 0)
+		return PR_void;
+	*regs_ready = true;
+	return get_sysnum(tracee, CURRENT);
+}
+
+/**
+ * Answer a suppressed seccomp trap the way the guest's own SIGSYS handler
+ * would: -ENOSYS in the result register.  SECCOMP_RET_TRAP skips the
+ * syscall, and the kernel's rollback does not promise -ENOSYS there - on
+ * arm64 it restores x0 to the call's first argument, which for clone3(2)
+ * is a pointer a libc cannot tell from a tid.  Snapshot CURRENT as
+ * ORIGINAL first so push_regs()' restore pass is a no-op, then poke only
+ * the result register (seccomp(2); ADR-0166).
+ */
+static int seccomp_trap_answer_enosys(Tracee *tracee)
+{
+	save_current_regs(tracee, ORIGINAL);
+	poke_reg(tracee, SYSARG_RESULT, (word_t) -ENOSYS);
+	return push_regs(tracee);
+}
+
+/* The most an exec environment is expected to reach; a longer one
+ * loses only its tail to the scan, and a miss answers ABSENT - the
+ * signal is then delivered as stock proot does.  */
+#define SIGSYS_ENVIRON_MAX (64 * 1024)
+
+/**
+ * Scan @tracee's exec environment for PROOT_SIGSYS_ENOSYS.  Entries in
+ * /proc/<pid>/environ are NUL-separated, and the file reports the
+ * environment execve(2) was given - where a kernelspec's env lands,
+ * invisible to the tracer's own getenv.  Presence is the whole test,
+ * matching getenv(3): any value, empty included, asks for ENOSYS-only.
+ */
+static bool tracee_environ_has_sigsys_enosys(Tracee *tracee)
+{
+	static const char marker[] = "PROOT_SIGSYS_ENOSYS=";
+	const size_t marker_len = sizeof(marker) - 1;
+	char proc_path[64]; /* > sizeof("/proc//environ") + 2 * sizeof(#ULONG_MAX) */
+	char *buf;
+	ssize_t got;
+	size_t i;
+	int status, fd;
+
+	buf = talloc_size(tracee->ctx, SIGSYS_ENVIRON_MAX);
+	if (buf == NULL)
+		return false;
+
+	status = snprintf(proc_path, sizeof(proc_path), "/proc/%d/environ",
+			  tracee->pid);
+	if (status < 0 || (size_t) status >= sizeof(proc_path))
+		return false;
+
+	fd = open(proc_path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return false;
+	got = read(fd, buf, SIGSYS_ENVIRON_MAX);
+	close(fd);
+	if (got <= 0)
+		return false;
+
+	for (i = 0; i + marker_len <= (size_t) got; i++) {
+		if ((i == 0 || buf[i - 1] == '\0') &&
+		    memcmp(buf + i, marker, marker_len) == 0)
+			return true;
+	}
+	return false;
+}
+
+/**
+ * @tracee's own PROOT_SIGSYS_ENOSYS answer, computed once per exec'd
+ * program: the SIGSYS case asks it on every seccomp trap, and
+ * PTRACE_EVENT_EXEC resets it because execve(2) is the one event that
+ * replaces the environment it is read from.
+ */
+static int tracee_sigsys_enosys(Tracee *tracee)
+{
+	if (tracee->sigsys_enosys == SIGSYS_ENOSYS_UNKNOWN)
+		tracee->sigsys_enosys = tracee_environ_has_sigsys_enosys(tracee)
+		    ? SIGSYS_ENOSYS_PRESENT : SIGSYS_ENOSYS_ABSENT;
+	return tracee->sigsys_enosys;
+}
+
