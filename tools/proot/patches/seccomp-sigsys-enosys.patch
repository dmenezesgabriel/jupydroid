+			/* A seccomp trap is not an ENOSYS by itself: the
+			 * syscall never ran, so the result register holds
+			 * whatever the kernel's rollback left - on arm64 the
+			 * call's first argument, which clone3(2)'s caller
+			 * cannot tell from a tid.  Suppression therefore has
+			 * to write -ENOSYS before the signal is dropped, the
+			 * same value the guest's SIGSYS handler would return
+			 * (seccomp(2); ADR-0166).  PROOT_SIGSYS_ENOSYS asks
+			 * for that on every seccomp trap, for a libc whose
+			 * signal path cannot survive delivery (measured on
+			 * glibc under threads by
+			 * GlibcPythonWheelProbeDeviceTest); the rest keep the
+			 * handler.  The variable is read on
+			 * the tracer's own environment for a whole traced tree,
+			 * and on the tracee's for one program - a kernelspec's
+			 * env reaches only the tracee.  The loader's startup
+			 * pair is ENOSYS-safe for everyone - no handler is
+			 * armed yet.  */
+			if (answer_enosys && seccomp_trap_answer_enosys(tracee) == 0) {
+				signal = 0;
+				VERBOSE(tracee, 1,
+					"vpid %" PRIu64 ": answered ENOSYS for "
+					"%s; SIGSYS suppressed",
+					tracee->vpid, stringify_sysnum(sysnum));
+			}
+			else {
+				VERBOSE(tracee, 1,
+					"vpid %" PRIu64 ": delivering SIGSYS for "
+					"syscall %d (%s)",
+					tracee->vpid, arch_nr,
+					stringify_sysnum(sysnum));
+			}
+			break;
+		}
+
 		default:
 			/* Deliver this signal as-is.  */
 			break;
