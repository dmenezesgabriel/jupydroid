 /**
+ * Whether a seccomp-trapped syscall is one only a loader's startup can
+ * issue: the optional calls glibc's ld.so makes before any preload
+ * constructor can arm a SIGSYS handler (set_robust_list, rseq).  The
+ * set is the whole refused set of one complete startup trace, derived
+ * once - package code cannot run inside that window, so nothing a
+ * package does can ever need a case here.  Every later refusal is the
+ * guest's own SIGSYS handler's to answer with ENOSYS, or ENOSYS-only
+ * under PROOT_SIGSYS_ENOSYS.
+ */
+static bool seccomp_trap_is_enosys_safe(Sysnum sysnum)
+{
+	switch (sysnum) {
+	case PR_set_robust_list:
+	case PR_rseq:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/**
+ * The syscall a SIGSYS stop was raised for: PR_void when the stop is not a
+ * seccomp trap or its number cannot be read.  @is_seccomp tells the two
+ * apart - a genuine SIGSYS (si_code != SYS_SECCOMP) must still be delivered
+ * even under PROOT_SIGSYS_ENOSYS.  @arch_nr is the raw number the kernel
+ * reports (-1 likewise); si_syscall is the architecture's own number - on
+ * arm64 the one in x8 - which is also what get_sysnum translates.
+ */
+static Sysnum seccomp_trap_sysnum(Tracee *tracee, int *arch_nr, bool *is_seccomp)
+{
+	siginfo_t siginfo;
+
+	*arch_nr = -1;
+	*is_seccomp = false;
+	if (ptrace(PTRACE_GETSIGINFO, tracee->pid, NULL, &siginfo) < 0)
+		return PR_void;
+	if (siginfo.si_code != SYS_SECCOMP)
+		return PR_void;
+	*is_seccomp = true;
+	if (fetch_regs(tracee) < 0)
+		return PR_void;
+	*arch_nr = siginfo.si_syscall;
+	return get_sysnum(tracee, CURRENT);
+}
+
+/**
  * For kernels >= 4.8.0
  * Handle the current event (@tracee_status) of the given @tracee.
  * This function returns the "computed" signal that should be used to
@@ -602,6 +648,40 @@
 			}
 			break;
 
+		case SIGSYS: {
+			int arch_nr;
+			bool is_seccomp;
+			Sysnum sysnum = seccomp_trap_sysnum(tracee, &arch_nr, &is_seccomp);
+
+			/* Dropping the signal leaves the ENOSYS the kernel
+			 * already set standing - what a guest SIGSYS handler
+			 * returning normally does, without the round trip
+			 * through it.  PROOT_SIGSYS_ENOSYS asks for that on
+			 * every seccomp trap, for a libc whose signal path
+			 * cannot survive delivery (measured on glibc under
+			 * threads by GlibcPythonWheelProbeDeviceTest); the
+			 * rest keep the handler.  The loader's startup pair
+			 * is ENOSYS-safe for everyone - no handler is armed
+			 * yet.  */
+			if (is_seccomp &&
+			    (getenv("PROOT_SIGSYS_ENOSYS") != NULL ||
+			     seccomp_trap_is_enosys_safe(sysnum))) {
+				signal = 0;
+				VERBOSE(tracee, 1,
+					"vpid %" PRIu64 ": suppressed SIGSYS for "
+					"%s; ENOSYS stands",
+					tracee->vpid, stringify_sysnum(sysnum));
+			}
+			else {
+				VERBOSE(tracee, 1,
+					"vpid %" PRIu64 ": delivering SIGSYS for "
+					"syscall %d (%s)",
+					tracee->vpid, arch_nr,
+					stringify_sysnum(sysnum));
+			}
+			break;
+		}
+
 		default:
 			/* Deliver this signal as-is.  */
 			break;
